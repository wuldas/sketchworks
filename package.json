{
  "name": "sketch-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:grid": "node tests/grid.browser.mjs",
    "test:canvas": "node tests/canvas.browser.mjs",
    "test:dimension": "node tests/dimension.browser.mjs",
    "test:endpoints": "node tests/endpoints.browser.mjs",
    "test:snap-options": "node tests/snap-options.browser.mjs",
    "test:commands": "node tests/command-panel.browser.mjs",
    "test:circles": "node tests/circle-diameter.browser.mjs",
    "test:contours": "node tests/contour-selection.browser.mjs",
    "test:pdf": "node tests/pdf-export.browser.mjs",
    "test:files": "node tests/file-manager.browser.mjs",
    "test:recovery": "node tests/workspace-recovery.browser.mjs",
    "docs:shots": "node scripts/readme-screenshots.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests package.json vite.config.ts index.html"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.2",
    "@salusoft89/planegcs": "1.3.0",
    "clipper-lib": "6.4.2",
    "dxf-writer": "^1.18.4",
    "fflate": "0.8.2",
    "idb": "8.0.3",
    "lucide-react": "^0.468.0",
    "mathjs": "^15.1.0",
    "paper": "^0.12.18",
    "pdf-lib": "1.17.1",
    "rbush": "4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/rbush": "4.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "dxf-parser": "^1.1.2",
    "fake-indexeddb": "6.0.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
